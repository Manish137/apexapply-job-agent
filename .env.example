# .env.example - ApexApply Auto-Apply Job Agent
# Copy to .env and adjust configurations

# LLM Configuration
# Options: mock (offline, keyword matching), anthropic (Claude), gemini_free, local_ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Resume used for every application (defaults to data/base_resumes/manish_shukla_fdpm_resume.txt)
BASE_RESUME_PATH=

# Execution Mode
DEFAULT_SUBMISSION_MODE=manual_confirm  # manual_confirm (Mode A) or auto_submit (Mode B)
MATCH_SCORE_THRESHOLD=70  # Auto-queue threshold (0-100)
BORDERLINE_THRESHOLD=50   # Below this the job is skipped

# Extra job feed folders (JSON files), separated by ':' (';' on Windows). data/jobs is always scanned.
SCRAPER_OUTPUT_DIR=
DATA_DIR=./data
DB_PATH=./data/job_agent.db

# Browser Automation
HEADLESS=true
