# ── AI provider ─────────────────────────────────────────
# gemini (free tier) or claude (paid, uses your Anthropic API credits)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Submitting ──────────────────────────────────────────
# review = fill forms and stop for your click; auto = submit complete Greenhouse/Lever/Ashby forms
SUBMIT_MODE=review

# ── Dashboard login (user name is "apex") ───────────────
DASHBOARD_PASSWORD=

# Git branch the container runs
APEX_BRANCH=main
