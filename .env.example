# .env.example - ApexApply Auto-Apply Job Agent
# Copy to .env and adjust configurations

# LLM Configuration (free-tier by default)
LLM_PROVIDER=mock  # Options: mock, gemini_free, local_ollama
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Execution Mode
DEFAULT_SUBMISSION_MODE=manual_confirm  # manual_confirm (Mode A) or auto_submit (Mode B)
MATCH_SCORE_THRESHOLD=70  # Auto-queue threshold (0-100)
BORDERLINE_THRESHOLD=50   # Show for manual review (50-70)

# Scraper & File Paths
SCRAPER_OUTPUT_DIR=/Users/manishshukla/.gemini/antigravity-ide/scratch/agent-command-center/output/jobs
DATA_DIR=./data
DB_PATH=./data/job_agent.db

# Browser Automation
HEADLESS=true
RATE_LIMIT_PER_HOUR=8
RANDOM_DELAY_MIN_SEC=1.5
RANDOM_DELAY_MAX_SEC=4.0
